 {"label": "A4 saved: the window closes, the card flies the new route", "eval": "({ open: !!document.querySelector('.route-maker'), route: document.querySelector(\"select[aria-label='경로']\")?.value, card: document.querySelector('.react-flow__node.selected .sn-text, .react-flow__node .sn-text')?.innerText })", "expect": {"open": false, "route": "new_route", "card": "경로 비행 · QA 고정 경로 · 반복"}},
 {"select": ["select[aria-label='경로']", "__new_route__"], "wait": 1500},
 {"type": ["input[aria-label='경로 이름']", "QA 상대 경로"]},
