{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/tools/guard/check_edit.py\" pre"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^apply_patch$",
        "hooks": [{"type": "command", "command": "python3 \"$(git rev-parse --show-toplevel)/tools/guard/check_edit.py\" post"}]
      }
    ]
  }
}
