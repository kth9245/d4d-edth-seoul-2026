{
  "$defs": {
    "Action": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionKind": {
      "enum": [
        "move_to",
        "patrol_route",
        "search_area",
        "return_home",
        "watch_target",
        "watch_point",
        "approach_target",
        "relay_comms",
        "hold",
        "strike_target"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "Choice": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "play_by_vehicle": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Play By Vehicle",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Condition": {
      "properties": {
        "kind": {
          "$ref": "#/$defs/ConditionKind"
        },
        "params": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ]
          },
          "default": {},
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "target_found",
        "arrived",
        "time_elapsed",
        "battery_below",
        "operator_choice",
        "signal_received"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Domain": {
      "enum": [
        "air",
        "sea",
        "ground"
      ],
      "title": "Domain",
      "type": "string"
    },
    "EmergencyRules": {
      "properties": {
        "battery_low_pct": {
          "default": 30,
          "title": "Battery Low Pct",
          "type": "number"
        },
        "link_lost_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Lost Step"
        },
        "battery_low_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Battery Low Step"
        },
        "operator_call_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Operator Call Step"
        }
      },
      "title": "EmergencyRules",
      "type": "object"
    },
    "EnemySpec": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "speed_mps": {
          "title": "Speed Mps",
          "type": "number"
        },
        "appear_offset_ms": {
          "title": "Appear Offset Ms",
          "type": "integer"
        },
        "pos": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoPoint"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "from_enemy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "From Enemy"
        },
        "play_id": {
          "title": "Play Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "speed_mps",
        "appear_offset_ms",
        "play_id"
      ],
      "title": "EnemySpec",
      "type": "object"
    },
    "Exit": {
      "properties": {
        "cond": {
          "$ref": "#/$defs/Condition"
        },
        "go_step": {
          "title": "Go Step",
          "type": "string"
        }
      },
      "required": [
        "cond",
        "go_step"
      ],
      "title": "Exit",
      "type": "object"
    },
    "GeoPoint": {
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "alt_m": {
          "default": 0,
          "title": "Alt M",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "Operation": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "purpose": {
          "default": "",
          "title": "Purpose",
          "type": "string"
        },
        "area": {
          "$ref": "#/$defs/Polygon"
        },
        "zone": {
          "$ref": "#/$defs/Polygon"
        },
        "vehicle_ids": {
          "items": {
            "type": "string"
          },
          "title": "Vehicle Ids",
          "type": "array"
        },
        "started_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started Ms"
        },
        "assign": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Assign",
          "type": "object"
        },
        "reserve": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "default": {},
          "title": "Reserve",
          "type": "object"
        },
        "switches": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Switch"
          },
          "title": "Switches",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "area",
        "zone",
        "vehicle_ids"
      ],
      "title": "Operation",
      "type": "object"
    },
    "Play": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "domains": {
          "items": {
            "$ref": "#/$defs/Domain"
          },
          "title": "Domains",
          "type": "array"
        },
        "steps": {
          "items": {
            "$ref": "#/$defs/Step"
          },
          "title": "Steps",
          "type": "array"
        },
        "entry": {
          "title": "Entry",
          "type": "string"
        },
        "emergency": {
          "$ref": "#/$defs/EmergencyRules",
          "default": {
            "battery_low_pct": 30.0,
            "link_lost_step": null,
            "battery_low_step": null,
            "operator_call_step": null
          }
        },
        "origin": {
          "default": "human",
          "enum": [
            "human",
            "ai_draft"
          ],
          "title": "Origin",
          "type": "string"
        },
        "approved": {
          "default": false,
          "title": "Approved",
          "type": "boolean"
        },
        "template": {
          "default": false,
          "title": "Template",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "domains",
        "steps",
        "entry"
      ],
      "title": "Play",
      "type": "object"
    },
    "Polygon": {
      "properties": {
        "points": {
          "items": {
            "$ref": "#/$defs/GeoPoint"
          },
          "minItems": 3,
          "title": "Points",
          "type": "array"
        }
      },
      "required": [
        "points"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "ReportSpec": {
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "choices": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Choice"
          },
          "title": "Choices",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "ReportSpec",
      "type": "object"
    },
    "ScenarioEvent": {
      "properties": {
        "offset_ms": {
          "title": "Offset Ms",
          "type": "integer"
        },
        "kind": {
          "enum": [
            "spawn_target",
            "target_move",
            "vehicle_link_lost",
            "vehicle_battery_set",
            "split_target"
          ],
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "offset_ms",
        "kind",
        "params"
      ],
      "title": "ScenarioEvent",
      "type": "object"
    },
    "Step": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "do": {
          "$ref": "#/$defs/Action"
        },
        "on": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Exit"
          },
          "title": "On",
          "type": "array"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReportSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ui": {
          "additionalProperties": true,
          "default": {},
          "title": "Ui",
          "type": "object"
        }
      },
      "required": [
        "id",
        "name",
        "do"
      ],
      "title": "Step",
      "type": "object"
    },
    "Switch": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "play_by_vehicle": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Play By Vehicle",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label",
        "play_by_vehicle"
      ],
      "title": "Switch",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "boat",
        "fast_boat",
        "person",
        "unknown"
      ],
      "title": "TargetKind",
      "type": "string"
    },
    "VehicleSpec": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "speed_mps": {
          "title": "Speed Mps",
          "type": "number"
        },
        "endurance_min": {
          "title": "Endurance Min",
          "type": "number"
        },
        "sensor_range_m": {
          "title": "Sensor Range M",
          "type": "number"
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/ActionKind"
          },
          "title": "Capabilities",
          "type": "array"
        },
        "home": {
          "$ref": "#/$defs/GeoPoint"
        }
      },
      "required": [
        "id",
        "name",
        "domain",
        "speed_mps",
        "endurance_min",
        "sensor_range_m",
        "capabilities",
        "home"
      ],
      "title": "VehicleSpec",
      "type": "object"
    }
  },
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/Operation"
    },
    "vehicles": {
      "items": {
        "$ref": "#/$defs/VehicleSpec"
      },
      "title": "Vehicles",
      "type": "array"
    },
    "plays": {
      "items": {
        "$ref": "#/$defs/Play"
      },
      "title": "Plays",
      "type": "array"
    },
    "events": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ScenarioEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "enemies": {
      "default": [],
      "items": {
        "$ref": "#/$defs/EnemySpec"
      },
      "title": "Enemies",
      "type": "array"
    },
    "land": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Polygon"
      },
      "title": "Land",
      "type": "array"
    },
    "seed": {
      "default": 0,
      "title": "Seed",
      "type": "integer"
    },
    "tick_ms": {
      "default": 200,
      "title": "Tick Ms",
      "type": "integer"
    },
    "speed": {
      "default": 1.0,
      "title": "Speed",
      "type": "number"
    }
  },
  "required": [
    "id",
    "operation",
    "vehicles",
    "plays"
  ],
  "title": "Scenario",
  "type": "object"
}
