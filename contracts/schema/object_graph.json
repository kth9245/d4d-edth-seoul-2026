    "ObjectLink": {
      "properties": {
        "src": {
          "title": "Src",
          "type": "string"
        },
        "dst": {
          "title": "Dst",
          "type": "string"
        },
        "rel": {
          "enum": [
            "reported",
            "about",
            "answers",
            "from_decision",
            "sent_to",
            "aims_at",
