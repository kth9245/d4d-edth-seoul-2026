        }
      },
      "required": [
        "kind"
      ],
      "title": "Action",
      "type": "object"
    },
    "ActionKind": {
      "enum": [
        "move_to",
        "patrol_route",
        "search_area",
        "return_home",
        "watch_target",
        "watch_point",
        "approach_target",
        "relay_comms",
        "hold",
        "strike_target"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "Choice": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "role_by_vehicle": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Role By Vehicle",
          "type": "object"
        },
        "target_by_vehicle": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Target By Vehicle",
          "type": "object"
        }
      },
      "required": [
        "id",
        "label"
      ],
      "title": "Choice",
      "type": "object"
    },
    "Condition": {
