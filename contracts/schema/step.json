      "required": [
        "kind"
      ],
      "title": "Condition",
      "type": "object"
    },
    "ConditionKind": {
      "enum": [
        "target_found",
        "arrived",
        "time_elapsed",
        "battery_below",
        "operator_choice",
        "signal_received",
        "at_time",
        "target_neutralized"
      ],
      "title": "ConditionKind",
      "type": "string"
    },
    "Exit": {
      "properties": {
